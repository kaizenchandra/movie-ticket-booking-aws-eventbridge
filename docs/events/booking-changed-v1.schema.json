{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cinema:booking-changed:1",
  "title": "BookingChanged.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "type",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "status",
    "showId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "showId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "BookingChanged"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "HELD",
        "PAYMENT_PENDING",
        "CONFIRMED",
        "EXPIRED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "traceParent": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional W3C traceparent context"
    }
  }
}
